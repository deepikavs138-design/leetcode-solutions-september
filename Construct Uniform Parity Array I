class Solution {
public:
    bool uniformArray(vector<int>& nums1) {
        int n = nums1.size();
        if (n == 1) return true; // single element is trivially uniform
        
        bool hasEven = false, hasOdd = false;
        for (int x : nums1) {
            if (x % 2 == 0) hasEven = true;
            else hasOdd = true;
        }
        
        // If all are even or all are odd → true
        if (!hasEven || !hasOdd) return true;
        
        // If both exist, we can always construct odd array
        return true;
    }
};
