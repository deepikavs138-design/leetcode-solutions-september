class Solution {
public:
    int reverseDegree(string s) {
        int n = s.size();
        long long result = 0;
        
        for (int i = 0; i < n; i++) {
            // position in string (1-indexed)
            int pos = i + 1;
            
            // reverse alphabet index
            int revIndex = 26 - (s[i] - 'a');
            
            result += revIndex * pos;
        }
        
        return result;
    }
};
