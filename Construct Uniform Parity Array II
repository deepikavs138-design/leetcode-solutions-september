#include <vector>
#include <algorithm>
#include <climits>

class Solution {
public:
    bool uniformArray(std::vector<int>& nums1) {
        int minOdd = INT_MAX;
        int minEven = INT_MAX;
        
        // Find the minimum odd and minimum even numbers in the array
        for (int num : nums1) {
            if (num % 2 != 0) {
                minOdd = std::min(minOdd, num);
            } else {
                minEven = std::min(minEven, num);
            }
        }
        
        // If all numbers are already of the same parity (all odds or all evens)
        if (minOdd == INT_MAX || minEven == INT_MAX) {
            return true;
        }
        
        // If there is a mix, we must target all odds.
        // This is only possible if the smallest odd is less than the smallest even.
        return minOdd < minEven;
    }
};
