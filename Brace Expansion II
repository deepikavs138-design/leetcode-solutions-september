class Solution {
public:
    vector<string> braceExpansionII(string expression) {
        set<string> result = parse(expression);
        return vector<string>(result.begin(), result.end());
    }
    
private:
    // Parse an expression
    set<string> parse(string expr) {
        vector<set<string>> parts;
        int i = 0, n = expr.size();
        
        while (i < n) {
            if (expr[i] == '{') {
                int j = i, balance = 0;
                do {
                    if (expr[j] == '{') balance++;
                    if (expr[j] == '}') balance--;
                    j++;
                } while (balance > 0);
                // recursive parse inside braces
                parts.push_back(unionParse(expr.substr(i+1, j-i-2)));
                i = j;
            } else if (isalpha(expr[i])) {
                parts.push_back({string(1, expr[i])});
                i++;
            }
        }
        
        // concatenate all parts
        set<string> res = {""};
        for (auto &p : parts) {
            set<string> temp;
            for (auto &a : res) {
                for (auto &b : p) {
                    temp.insert(a + b);
                }
            }
            res.swap(temp);
        }
        return res;
    }
    
    // Handle union inside braces
    set<string> unionParse(string expr) {
        set<string> res;
        int i = 0, n = expr.size(), balance = 0;
        string token;
        for (int j = 0; j < n; j++) {
            if (expr[j] == ',' && balance == 0) {
                auto sub = parse(token);
                res.insert(sub.begin(), sub.end());
                token.clear();
            } else {
                if (expr[j] == '{') balance++;
                if (expr[j] == '}') balance--;
                token.push_back(expr[j]);
            }
        }
        if (!token.empty()) {
            auto sub = parse(token);
            res.insert(sub.begin(), sub.end());
        }
        return res;
    }
};
