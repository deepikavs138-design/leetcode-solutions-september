class Solution {
public:
    int maxPalindromes(string s, int k) {
        int n = s.length();
        
        // Step 1: Precompute palindromes (Your logic here is spot on!)
        vector<vector<bool>> isPal(n, vector<bool>(n, false));
        for (int i = n - 1; i >= 0; i--) {
            for (int j = i; j < n; j++) {
                if (s[i] == s[j] && (j - i <= 2 || isPal[i + 1][j - 1])) {
                    isPal[i][j] = true;
                }
            }
        }
        
        // Step 2: Dynamic Programming
        // dp[i] stores the max number of non-overlapping palindromes in the prefix s[0...i-1]
        vector<int> dp(n + 1, 0);
        
        for (int i = 1; i <= n; i++) {
            // Option 1: We don't include the character at i-1 in any new palindrome
            dp[i] = dp[i - 1]; 
            
            // Option 2: We form a valid palindrome ending at i-1
            // We only check starting indices j such that the length (i - j) is >= k
            for (int j = i - k; j >= 0; j--) {
                if (isPal[j][i - 1]) {
                    dp[i] = max(dp[i], dp[j] + 1);
                }
            }
        }
        
        return dp[n];
    }
};
